{
    "name": "ketapay/ketapay-php",
    "description": "Official PHP library for the KetaPay escrow API",
    "type": "library",
    "license": "MIT",
    "keywords": ["ketapay", "escrow", "payments", "nigeria", "api", "sdk"],
    "homepage": "https://github.com/KetaPay/ketapay-php",
    "support": {
        "issues": "https://github.com/KetaPay/ketapay-php/issues",
        "docs": "https://docs.ketapay.com"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "symfony/yaml": "^6.4"
    },
    "suggest": {
        "ext-curl": "The default transport. Without it the SDK falls back to PHP streams.",
        "psr/http-client": "To send requests through your own PSR-18 client (KetaPay\\Http\\Psr18Transport)."
    },
    "autoload": {
        "psr-4": {
            "KetaPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KetaPay\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
        "sync-spec": "php scripts/sync-spec.php",
        "generate": "php scripts/generate.php",
        "check:spec": "php scripts/check-spec.php",
        "check:drift": "php scripts/check-drift.php",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff",
        "lint": ["phpstan analyse --memory-limit=1G --no-progress", "phpstan analyse --memory-limit=1G --no-progress -c phpstan-scripts.neon"],
        "test": "phpunit --testsuite unit",
        "test:coverage": "XDEBUG_MODE=coverage phpunit --testsuite unit --coverage-html coverage --coverage-clover coverage/clover.xml",
        "test:ci": "phpunit --testsuite unit --coverage-clover coverage/clover.xml --coverage-html coverage --log-junit reports/unit.xml --testdox-text reports/unit-testdox.txt",
        "test:coverage-check": "php scripts/check-coverage.php",
        "test:contract": "php scripts/contract-test.php",
        "test:e2e": "phpunit --testsuite e2e",
        "test:catalogue": "phpunit --filter CatalogueCoverageTest",
        "test:report": "php scripts/test-summary.php",
        "smoke:package": "php scripts/smoke-package.php"
    },
    "scripts-descriptions": {
        "sync-spec": "Copy the public spec and test catalogue from the documentation repo",
        "generate": "Regenerate src/Generated from spec/v1.yaml",
        "smoke:package": "Install the exact archive into an empty project and use it like a customer"
    }
}
