# The SDK and its tests at the strictest level. Dev scripts have their own, looser config (phpstan-scripts.neon).
parameters:
    # Analyse as the oldest PHP the SDK supports: flags newer syntax even on a newer local PHP. It does NOT catch
    # newer functions or constants (they exist in the PHP running PHPStan): CI's run on that PHP does.
    phpVersion: 80100
    level: max
    paths:
        - src
        - tests
        - init.php
    excludePaths:
        - tests/Support/server.php (?)
    tmpDir: .phpstan-cache
    # Public methods validate what callers pass at runtime too, because most PHP callers run no static analysis.
    treatPhpDocTypesAsCertain: false
